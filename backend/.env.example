# =============================================================================
# MediCare+ — Modèle de configuration d'environnement
# =============================================================================
# Copier ce fichier vers ".env" et remplacer TOUTES les valeurs :
#
#   Copy-Item .env.example .env
#
# ⚠️  Ne JAMAIS committer le fichier ".env" (il contient des secrets).
# =============================================================================

# --- Base de données ---
DATABASE_NAME=medicareplus
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=medicareplus
DATABASE_PASSWORD=replace-with-a-strong-database-password

# --- Conteneur MySQL (Docker uniquement) ---
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# --- Sécurité JWT ---
# Doit contenir AU MOINS 32 caractères aléatoires
# Génération : -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- Comptes de démonstration (profil "demo") ---
# Doit contenir AU MOINS 12 caractères
DEMO_PASSWORD=replace-with-a-demo-password-of-12-characters

# --- Serveur ---
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:8443

# --- Email (Mailpit en développement) ---
MAIL_FROM=no-reply@medicareplus.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025